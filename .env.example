# GEMINI_API_KEY: Required for FloodShield Copilot AI Disaster Assistant.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Required for Google Maps JavaScript API in React.
VITE_GOOGLE_MAPS_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OPEN_METEO_BASE_URL: Real-time meteorological forecast endpoint (no key required)
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1/forecast"

# OPEN_METEO_FLOOD_URL: GloFAS river discharge telemetry endpoint (no key required)
OPEN_METEO_FLOOD_URL="https://flood-api.open-meteo.com/v1/flood"

# OPENWEATHER_API_KEY: Optional OpenWeatherMap API key for supplementary station data
OPENWEATHER_API_KEY=""

# NASA_EARTHDATA_TOKEN: Optional NASA GPM / MODIS precipitation token
NASA_EARTHDATA_TOKEN=""

